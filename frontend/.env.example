# API Configuration
REACT_APP_API_URL=http://localhost:8081
REACT_APP_WS_URL=ws://localhost:8081

# Environment
REACT_APP_ENV=development

# Feature Flags
REACT_APP_ENABLE_LIVE_FEED=true
REACT_APP_ENABLE_ANALYTICS=true

# Polling Intervals (milliseconds)
REACT_APP_TRANSACTION_POLL_INTERVAL=5000
REACT_APP_DASHBOARD_REFRESH_INTERVAL=30000

# Pagination
REACT_APP_DEFAULT_PAGE_SIZE=20
REACT_APP_MAX_PAGE_SIZE=100

# Logging
REACT_APP_LOG_LEVEL=info
